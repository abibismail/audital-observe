# Local-only demo configuration. NEVER reuse in a public environment. Never commit real values.
# development = in-memory store; hosted-preview = PostgreSQL + RLS (still NOT production: see docs/PRODUCTION_GATES.md)
AUDITAL_OBSERVE_MODE=development
AUDITAL_API_KEY=replace-with-32-byte-random-key
AUDITAL_PROJECT_ID=example-project
AUDITAL_TENANT_ID=example-tenant
# Master HMAC secret (>= 32 bytes). Per-project keys are derived with HKDF; hashes never join across projects.
AUDITAL_HMAC_KEY=replace-with-32-byte-random-secret
# Read-only GitHub connector for the dev store (fine-grained token: Issues:read + Metadata:read only).
# Classic tokens advertising write scopes (repo, workflow, ...) are refused.
GITHUB_READ_TOKEN=
AUDITAL_PUBLIC_BASE_URL=http://127.0.0.1:8787
AUDITAL_SCHEDULER=on
# hosted-preview only:
AUDITAL_PG_APP_URL=          # login role that is a member of observe_app ONLY (never owner/superuser)
AUDITAL_PG_ADMIN_URL=        # migrations/provisioning only (npm run db:migrate); never given to the API
AUDITAL_VAULT_KEY_HEX=       # 64 hex chars; dev envelope vault (replace with KMS before production)
# Hosted attestation: only works if the key's public half is pinned in packages/observe-contract/trust/hosted-keys.json
AUDITAL_HOSTED_SIGNING_KEY_PEM_FILE=
AUDITAL_HOSTED_SIGNING_KID=
PORT=8787
